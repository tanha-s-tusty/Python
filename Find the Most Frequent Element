numbers = [1, 2, 2, 3, 1, 2, 4, 3]

frequency = {}

for num in numbers:
    if num in frequency:
        frequency[num] += 1
    else:
        frequency[num] = 1

most_frequent = numbers[0]

for num in frequency:
    if frequency[num] > frequency[most_frequent]:
        most_frequent = num

print("Most frequent element:", most_frequent)
print("Frequency:", frequency[most_frequent])

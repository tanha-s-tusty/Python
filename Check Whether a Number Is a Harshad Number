num = int(input("Enter a number: "))

if num <= 0:
    print("Enter a positive number")
else:
    temp = num
    digit_sum = 0

    while temp > 0:
        digit = temp % 10
        digit_sum += digit
        temp //= 10

    if num % digit_sum == 0:
        print("Harshad number")
    else:
        print("Not a Harshad number")

numbers = [64, 25, 12, 22, 11]

n = len(numbers)

for i in range(n):
    minimum_index = i

    for j in range(i + 1, n):
        if numbers[j] < numbers[minimum_index]:
            minimum_index = j

    numbers[i], numbers[minimum_index] = (
        numbers[minimum_index], numbers[i]
    )

print("Sorted list:", numbers)

def calculate_average(numbers):
    if len(numbers) == 0:
        return None

    total = 0

    for num in numbers:
        total += num

    return total / len(numbers)


values = [10, 20, 30, 40]

result = calculate_average(values)

if result is None:
    print("List is empty")
else:
    print("Average:", result)
